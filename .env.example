# Filled in as each epic needs them. Stripe: test-mode keys only.

# Auth (E2). Any random string of 32+ chars: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000
# SQLite file; created and migrated on boot.
DATABASE_URL=data/app.db

# Stripe (E6), test mode only. Setup: README → Stripe setup.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --print-secret`.
STRIPE_WEBHOOK_SECRET=whsec_...
